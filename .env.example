# Copia este archivo como .env y completa los valores.
# El .env está en .gitignore: nunca se sube al repositorio.

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/tickets_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- Datos de demostración ---
# Por defecto se cargan 5 usuarios de prueba (ver README). Para no cargarlos:
# FLYWAY_LOCATIONS=classpath:db/migration

# --- Proveedor de IA (Groq, API compatible con OpenAI) ---
# La key se crea en https://console.groq.com/keys
# Si AI_API_KEY queda vacío, la app no se cae: clasifica con el analizador
# por reglas y lo deja registrado en el campo origenAnalisis del ticket.
AI_API_KEY=
# Modelos disponibles: curl -H "Authorization: Bearer $AI_API_KEY" https://api.groq.com/openai/v1/models
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=10
